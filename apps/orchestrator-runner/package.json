{
  "name": "@monitor/orchestrator-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @monitor/agent-config build && pnpm --filter @monitor/orchestrator-core build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test ./test/**/*.test.ts",
    "prerun": "pnpm --filter @monitor/agent-config build && pnpm --filter @monitor/orchestrator-core build",
    "prestart": "pnpm --filter @monitor/agent-config build && pnpm --filter @monitor/orchestrator-core build",
    "run": "node --import tsx src/index.ts",
    "start": "node --import tsx src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@monitor/agent-config": "workspace:*",
    "@monitor/orchestrator-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6"
  }
}
