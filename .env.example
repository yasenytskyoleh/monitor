# Required for OpenAI-backed orchestrator handlers
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override API endpoint (default: https://api.openai.com/v1)
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: override model used by handlers (default falls back to agent runtime config)
OPENAI_MODEL=gpt-5.4-mini

# Local Docker Compose defaults (development only). If you override these values,
# update the connection URLs below to match; Node does not expand .env references.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=monitor
POSTGRES_TEST_DB=monitor_test

# Required for Prisma-backed product-domain persistence work
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monitor
# Optional direct connection for Prisma CLI when runtime traffic uses a pooler.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/monitor
# Optional disposable Postgres URL for real-database integration tests.
# Use a dedicated *_test or *_integration database because the suite drops product_domain.
PRODUCT_DOMAIN_INTEGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monitor_test

# Optional BTC pilot setup selector. The seed and monitor default to this canonical ID.
# A custom value must name an existing active setup definition with an accepted revision.
BTC_MONITOR_SETUP_DEFINITION_ID=setup-btc-breakout
# Optional canonical monitored symbol; defaults to BTC-USDT.
BTC_MONITOR_MONITORED_SYMBOL_ID=BTC-USDT
# Optional historical detector warm-up; defaults to 24 and accepts 1-720 hours.
BTC_MONITOR_BACKFILL_HOURS=24
# Optional maximum wait for the next live closed candle during btc-smoke; defaults to 90 seconds.
BTC_MONITOR_SMOKE_TIMEOUT_SECONDS=90
# Optional override for the product-domain Postgres schema; defaults to product_domain.
BTC_MONITOR_DATABASE_SCHEMA=

# Notification retention policy. These gate whether a fresh detection is retained as a pending
# decision-support alert. They are conservative filters, not investment advice.
# Evidence-policy label stored with each retained notification.
BTC_MONITOR_NOTIFICATION_POLICY_ID=btc-breakout-conservative-v1
# Minimum completed 24-hour evaluations behind the aggregate; defaults to 30.
BTC_MONITOR_NOTIFICATION_MIN_COMPLETED_EVALUATIONS=30
# Minimum positive-outcome ratio from 0 to 1; defaults to 0.6.
BTC_MONITOR_NOTIFICATION_MIN_POSITIVE_OUTCOME_RATE=0.6
# Minimum average 24-hour move percentage; defaults to 0.5.
BTC_MONITOR_NOTIFICATION_MIN_AVERAGE_PERCENTAGE_MOVE=0.5
# Freshness limit for the detected signal in minutes; defaults to 15.
BTC_MONITOR_NOTIFICATION_MAX_SIGNAL_AGE_MINUTES=15
# Freshness limit for the historical aggregate in hours; defaults to 24.
BTC_MONITOR_NOTIFICATION_MAX_AGGREGATE_AGE_HOURS=24
# Maximum pending alerts sent per btc-notify run, from 1 to 100; defaults to 10.
BTC_MONITOR_NOTIFICATION_MAX_DELIVERIES=10

# Telegram delivery is manual and opt-in; only `btc-notify` reads these. Leave them unset unless
# you have explicitly decided to deliver alerts. Never commit real values.
# Prefer the *_FILE variants, which read the value from a protected file outside the repository.
# A direct value and its _FILE counterpart cannot both be set.
# BTC_MONITOR_TELEGRAM_BOT_TOKEN=
# BTC_MONITOR_TELEGRAM_CHAT_ID=
# BTC_MONITOR_TELEGRAM_BOT_TOKEN_FILE=
# BTC_MONITOR_TELEGRAM_CHAT_ID_FILE=
# Per-request Telegram timeout in milliseconds, from 1 to 60000; defaults to 10000.
BTC_MONITOR_TELEGRAM_TIMEOUT_MS=10000
