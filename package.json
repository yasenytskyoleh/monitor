{
  "name": "monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "build": "turbo run build",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs --follow postgres",
    "infra:reset": "docker compose down --volumes",
    "infra:up": "docker compose up --detach --wait postgres",
    "db:migrate": "pnpm --filter @monitor/domain-model run db:migrate",
    "test": "turbo run test --concurrency=1",
    "test:integration": "pnpm --filter @monitor/domain-model run test:integration",
    "typecheck": "turbo run typecheck",
    "verify:persistence": "pnpm --filter @monitor/domain-model run verify:persistence",
    "lint": "turbo run lint",
    "runner": "pnpm --filter @monitor/orchestrator-runner run run --",
    "btc-monitor": "pnpm --filter @monitor/btc-monitor run start",
    "btc-evaluate": "pnpm --filter @monitor/btc-monitor run evaluate",
    "btc-notify": "pnpm --filter @monitor/btc-monitor run notify",
    "btc-seed": "pnpm --filter @monitor/btc-monitor run seed",
    "btc-smoke": "pnpm --filter @monitor/btc-monitor run smoke",
    "btc-pilot:prepare": "pnpm infra:up && docker compose --profile pilot build btc-migrate btc-monitor && docker compose --profile pilot run --rm --no-deps btc-migrate && docker compose --profile pilot run --rm --no-deps btc-seed",
    "btc-pilot": "pnpm btc-pilot:prepare && docker compose --profile pilot run --rm --no-deps btc-smoke",
    "btc-monitor:docker": "pnpm btc-pilot:prepare && docker compose --profile pilot up --no-deps btc-monitor",
    "btc-pilot:down": "docker compose --profile pilot down"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
