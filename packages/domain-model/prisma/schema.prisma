generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["product_domain"]
}

enum PersistedLifecycleStatus {
  active
  archived

  @@map("persisted_lifecycle_status")
  @@schema("product_domain")
}

enum ProductRecordSource {
  monitoring_pipeline
  detection_pipeline
  evaluation_pipeline
  research_aggregation_pipeline
  manual_curation
  migration_backfill

  @@map("product_record_source")
  @@schema("product_domain")
}

enum SetupDefinitionStatus {
  draft
  active
  paused
  archived

  @@map("setup_definition_status")
  @@schema("product_domain")
}

enum ResearchHypothesisStatus {
  draft
  active
  paused
  closed

  @@map("research_hypothesis_status")
  @@schema("product_domain")
}

enum SignalCandidateStatus {
  detected
  under_review
  evaluated
  discarded

  @@map("signal_candidate_status")
  @@schema("product_domain")
}

enum EvaluationStatus {
  pending
  in_progress
  completed
  expired
  invalidated

  @@map("evaluation_status")
  @@schema("product_domain")
}

enum AggregateComputationStatus {
  pending
  completed
  partial
  invalid

  @@map("aggregate_computation_status")
  @@schema("product_domain")
}

enum AggregationSymbolScopeKind {
  single_symbol
  symbol_set
  all_monitored

  @@map("aggregation_symbol_scope_kind")
  @@schema("product_domain")
}

enum HypothesisEvidenceStatus {
  supports
  weakens
  inconclusive

  @@map("hypothesis_evidence_status")
  @@schema("product_domain")
}

enum ResearchFeedbackDecisionAction {
  keep_active
  refine_definition
  pause_setup
  archive_setup
  manual_review_required

  @@map("research_feedback_decision_action")
  @@schema("product_domain")
}

enum ApprovedSetupLifecycleAction {
  keep_active
  pause_setup
  archive_setup

  @@map("approved_setup_lifecycle_action")
  @@schema("product_domain")
}

enum SetupRefinementStatus {
  proposed
  accepted
  in_progress
  completed
  rejected

  @@map("setup_refinement_status")
  @@schema("product_domain")
}

enum SetupDefinitionRevisionStatus {
  draft
  proposed
  accepted
  superseded
  rejected

  @@map("setup_definition_revision_status")
  @@schema("product_domain")
}

enum SetupRevisionActivationRecordOutcome {
  activated
  superseded_previous
  already_active

  @@map("setup_revision_activation_record_outcome")
  @@schema("product_domain")
}

enum ResearchFeedbackDecisionStatus {
  proposed
  reviewed
  accepted
  rejected

  @@map("research_feedback_decision_status")
  @@schema("product_domain")
}

enum ResearchDecisionApprovalStatus {
  recorded

  @@map("research_decision_approval_status")
  @@schema("product_domain")
}

enum ResearchDecisionApprovalOutcome {
  approved
  rejected
  needs_changes

  @@map("research_decision_approval_outcome")
  @@schema("product_domain")
}

enum ResearchReviewAuthorizedNextAction {
  confirm_no_change
  prepare_activation_follow_up
  prepare_lifecycle_mutation_follow_up
  prepare_refinement_follow_up

  @@map("research_review_authorized_next_action")
  @@schema("product_domain")
}

enum ResearchReviewDecisionStatus {
  recorded

  @@map("research_review_decision_status")
  @@schema("product_domain")
}

enum ResearchReviewDecisionOutcome {
  accepted
  rejected
  revise

  @@map("research_review_decision_outcome")
  @@schema("product_domain")
}

enum DownstreamActionTarget {
  apply_setup_lifecycle_mutation
  create_setup_refinement_request
  activate_setup_revision
  no_op_confirmed

  @@map("downstream_action_target")
  @@schema("product_domain")
}

enum ReviewDecisionDownstreamCommandType {
  ApplyApprovedSetupMutationCommand
  CreateSetupRefinementRequestCommand
  ActivateSetupDefinitionRevisionCommand
  NoOpConfirmed
  None

  @@map("review_decision_downstream_command_type")
  @@schema("product_domain")
}

enum ReviewDecisionRoutingStatus {
  routed
  no_action

  @@map("review_decision_routing_status")
  @@schema("product_domain")
}

enum RoutedActionExecutionStatus {
  prepared
  ready
  cancelled
  failed

  @@map("routed_action_execution_status")
  @@schema("product_domain")
}

enum MonitoredSymbolStatus {
  active
  paused
  archived

  @@map("monitored_symbol_status")
  @@schema("product_domain")
}

enum MarketScope {
  spot

  @@map("market_scope")
  @@schema("product_domain")
}

enum MonitorProviderHint {
  unknown
  exchange_adapter_pending

  @@map("monitor_provider_hint")
  @@schema("product_domain")
}

model MonitoredSymbolRecord {
  monitoredSymbolId     String                   @id(map: "monitored_symbol_pkey") @map("monitored_symbol_id") @db.Text
  version               Int                      @map("version")
  lifecycleStatus       PersistedLifecycleStatus @map("lifecycle_status")
  symbolStatus          MonitoredSymbolStatus    @map("symbol_status")
  baseAsset             String                   @map("base_asset") @db.Text
  quoteAsset            String                   @map("quote_asset") @db.Text
  displayName           String                   @map("display_name") @db.Text
  marketScope           MarketScope              @map("market_scope")
  providerHint          MonitorProviderHint      @map("provider_hint")
  tags                  String[]                 @map("tags")
  sourceBindings        Json                     @map("source_bindings")
  originRunId           String?                  @map("origin_run_id") @db.Text
  originTransitionId    String?                  @map("origin_transition_id") @db.Text
  createdBySource       ProductRecordSource      @map("created_by_source")
  lastUpdatedBySource   ProductRecordSource      @map("last_updated_by_source")
  traceId               String?                  @map("trace_id") @db.Text
  sourceObservedAtUtc   DateTime?                @map("source_observed_at_utc") @db.Timestamptz(3)
  metadataNotes         String?                  @map("metadata_notes") @db.Text
  createdAtUtc          DateTime                 @map("created_at_utc") @db.Timestamptz(3)
  updatedAtUtc          DateTime                 @map("updated_at_utc") @db.Timestamptz(3)
  archivedAtUtc         DateTime?                @map("archived_at_utc") @db.Timestamptz(3)

  @@index([symbolStatus], map: "idx_monitored_symbol_status")
  @@index([marketScope, symbolStatus], map: "idx_monitored_symbol_market_scope_status")
  @@map("monitored_symbol")
  @@schema("product_domain")
}

model SetupDefinitionRecord {
  setupDefinitionId         String                                       @id(map: "setup_definition_pkey") @map("setup_definition_id") @db.Text
  version                   Int                                          @map("version")
  lifecycleStatus           PersistedLifecycleStatus                     @map("lifecycle_status")
  definitionStatus          SetupDefinitionStatus                        @map("definition_status")
  name                      String                                       @map("name") @db.Text
  description               String                                       @map("description") @db.Text
  measurableConditions      String[]                                     @map("measurable_conditions")
  evaluationAssumptions     String[]                                     @map("evaluation_assumptions")
  invalidationAssumptions   String[]                                     @map("invalidation_assumptions")
  originRunId               String?                                      @map("origin_run_id") @db.Text
  originTransitionId        String?                                      @map("origin_transition_id") @db.Text
  createdBySource           ProductRecordSource                          @map("created_by_source")
  lastUpdatedBySource       ProductRecordSource                          @map("last_updated_by_source")
  traceId                   String?                                      @map("trace_id") @db.Text
  sourceObservedAtUtc       DateTime?                                    @map("source_observed_at_utc") @db.Timestamptz(3)
  metadataNotes             String?                                      @map("metadata_notes") @db.Text
  traceOriginRunId          String?                                      @map("trace_origin_run_id") @db.Text
  traceOriginTransitionId   String?                                      @map("trace_origin_transition_id") @db.Text
  traceMetadataTraceId      String?                                      @map("trace_metadata_trace_id") @db.Text
  createdAtUtc              DateTime                                     @map("created_at_utc") @db.Timestamptz(3)
  updatedAtUtc              DateTime                                     @map("updated_at_utc") @db.Timestamptz(3)
  archivedAtUtc             DateTime?                                    @map("archived_at_utc") @db.Timestamptz(3)
  hypothesisSetupLinks      ResearchHypothesisSetupDefinitionLinkRecord[]
  signalCandidates          SignalCandidateRecord[]
  aggregateResults          SetupAggregateResultRecord[]
  feedbackDecisions         ResearchFeedbackDecisionRecord[]
  decisionApprovals         ResearchDecisionApprovalRecord[]
  currentSetupDefinitionRevisions SetupDefinitionRevisionRecord[]        @relation("SetupDefinitionRevisionCurrentSetup")
  supersedingSetupDefinitionRevisions SetupDefinitionRevisionRecord[]    @relation("SetupDefinitionRevisionPreviousSetup")
  targetSetupRevisionActivationRecords SetupRevisionActivationRecordRecord[] @relation("SetupRevisionActivationRecordTargetSetup")
  previousSetupRevisionActivationRecords SetupRevisionActivationRecordRecord[] @relation("SetupRevisionActivationRecordPreviousSetup")
  setupLifecycleMutationRecords SetupLifecycleMutationRecordRecord[]
  setupRefinementRequests   SetupRefinementRequestRecord[]

  @@index([definitionStatus], map: "idx_setup_definition_definition_status")
  @@index([lifecycleStatus], map: "idx_setup_definition_lifecycle_status")
  @@map("setup_definition")
  @@schema("product_domain")
}

model ResearchHypothesisRecord {
  researchHypothesisId          String                                       @id(map: "research_hypothesis_pkey") @map("research_hypothesis_id") @db.Text
  version                       Int                                          @map("version")
  lifecycleStatus               PersistedLifecycleStatus                     @map("lifecycle_status")
  hypothesisStatus              ResearchHypothesisStatus                     @map("hypothesis_status")
  title                         String                                       @map("title") @db.Text
  description                   String                                       @map("description") @db.Text
  assumptions                   String[]                                     @map("assumptions")
  notes                         String[]                                     @map("notes")
  evidenceStatus                HypothesisEvidenceStatus?                    @map("evidence_status")
  evidenceSummary               String?                                      @map("evidence_summary") @db.Text
  lastEvidenceAggregateResultId String?                                      @map("last_evidence_aggregate_result_id") @db.Text
  lastEvidenceAssessedAt        DateTime?                                    @map("last_evidence_assessed_at") @db.Timestamptz(3)
  originRunId                   String?                                      @map("origin_run_id") @db.Text
  originTransitionId            String?                                      @map("origin_transition_id") @db.Text
  createdBySource               ProductRecordSource                          @map("created_by_source")
  lastUpdatedBySource           ProductRecordSource                          @map("last_updated_by_source")
  traceId                       String?                                      @map("trace_id") @db.Text
  sourceObservedAtUtc           DateTime?                                    @map("source_observed_at_utc") @db.Timestamptz(3)
  metadataNotes                 String?                                      @map("metadata_notes") @db.Text
  createdAtUtc                  DateTime                                     @map("created_at_utc") @db.Timestamptz(3)
  updatedAtUtc                  DateTime                                     @map("updated_at_utc") @db.Timestamptz(3)
  archivedAtUtc                 DateTime?                                    @map("archived_at_utc") @db.Timestamptz(3)
  setupDefinitionLinks          ResearchHypothesisSetupDefinitionLinkRecord[]
  aggregateResults              SetupAggregateResultRecord[]
  feedbackDecisions             ResearchFeedbackDecisionRecord[]
  reviewDecisions               ResearchReviewDecisionRecord[]

  @@index([hypothesisStatus], map: "idx_research_hypothesis_hypothesis_status")
  @@index([lifecycleStatus], map: "idx_research_hypothesis_lifecycle_status")
  @@map("research_hypothesis")
  @@schema("product_domain")
}

model ResearchHypothesisSetupDefinitionLinkRecord {
  researchHypothesisId String                   @map("research_hypothesis_id") @db.Text
  setupDefinitionId    String                   @map("setup_definition_id") @db.Text
  linkedAtUtc          DateTime                 @map("linked_at_utc") @db.Timestamptz(3)
  researchHypothesis   ResearchHypothesisRecord @relation(fields: [researchHypothesisId], references: [researchHypothesisId], onDelete: Restrict, onUpdate: Cascade)
  setupDefinition      SetupDefinitionRecord    @relation(fields: [setupDefinitionId], references: [setupDefinitionId], onDelete: Restrict, onUpdate: Cascade)

  @@id([researchHypothesisId, setupDefinitionId], map: "research_hypothesis_setup_definition_link_pkey")
  @@index([setupDefinitionId], map: "idx_research_hypothesis_link_setup_definition_id")
  @@map("research_hypothesis_setup_definition_link")
  @@schema("product_domain")
}

model SignalCandidateRecord {
  signalCandidateId    String                   @id(map: "signal_candidate_pkey") @map("signal_candidate_id") @db.Text
  version              Int                      @map("version")
  lifecycleStatus      PersistedLifecycleStatus @map("lifecycle_status")
  candidateStatus      SignalCandidateStatus    @map("candidate_status")
  setupDefinitionId    String                   @map("setup_definition_id") @db.Text
  setupRevisionId      String                   @map("setup_revision_id") @db.Text
  monitoredSymbolId    String                   @map("monitored_symbol_id") @db.Text
  detectionHitId       String?                  @map("detection_hit_id") @db.Text
  detectedAtUtc        DateTime                 @map("detected_at_utc") @db.Timestamptz(3)
  evidenceSummary      String                   @map("evidence_summary") @db.Text
  candidateOriginRunId String?                  @map("candidate_origin_run_id") @db.Text
  originRunId          String?                  @map("origin_run_id") @db.Text
  originTransitionId   String?                  @map("origin_transition_id") @db.Text
  createdBySource      ProductRecordSource      @map("created_by_source")
  lastUpdatedBySource  ProductRecordSource      @map("last_updated_by_source")
  traceId              String?                  @map("trace_id") @db.Text
  sourceObservedAtUtc  DateTime?                @map("source_observed_at_utc") @db.Timestamptz(3)
  metadataNotes        String?                  @map("metadata_notes") @db.Text
  createdAtUtc         DateTime                 @map("created_at_utc") @db.Timestamptz(3)
  updatedAtUtc         DateTime                 @map("updated_at_utc") @db.Timestamptz(3)
  archivedAtUtc        DateTime?                @map("archived_at_utc") @db.Timestamptz(3)
  setupDefinition      SetupDefinitionRecord    @relation(fields: [setupDefinitionId], references: [setupDefinitionId], onDelete: Restrict, onUpdate: Cascade)
  evaluationResults    EvaluationResultRecord[]

  @@index([setupDefinitionId], map: "idx_signal_candidate_setup_definition_id")
  @@index([monitoredSymbolId], map: "idx_signal_candidate_monitored_symbol_id")
  @@index([candidateStatus], map: "idx_signal_candidate_candidate_status")
  @@map("signal_candidate")
  @@schema("product_domain")
}

model EvaluationResultRecord {
  evaluationResultId    String                   @id(map: "evaluation_result_pkey") @map("evaluation_result_id") @db.Text
  version               Int                      @map("version")
  lifecycleStatus       PersistedLifecycleStatus @map("lifecycle_status")
  evaluationStatus      EvaluationStatus         @map("evaluation_status")
  signalCandidateId     String                   @map("signal_candidate_id") @db.Text
  evaluationWindowId    String                   @map("evaluation_window_id") @db.Text
  referencePrice        Float?                   @map("reference_price") @db.DoublePrecision
  finalPrice            Float?                   @map("final_price") @db.DoublePrecision
  highInWindow          Float?                   @map("high_in_window") @db.DoublePrecision
  lowInWindow           Float?                   @map("low_in_window") @db.DoublePrecision
  absoluteMove          Float?                   @map("absolute_move") @db.DoublePrecision
  percentageMove        Float?                   @map("percentage_move") @db.DoublePrecision
  maxFavorableExcursion Float?                   @map("max_favorable_excursion") @db.DoublePrecision
  maxAdverseExcursion   Float?                   @map("max_adverse_excursion") @db.DoublePrecision
  evaluatedAtUtc        DateTime?                @map("evaluated_at_utc") @db.Timestamptz(3)
  notes                 String?                  @map("notes") @db.Text
  originRunId           String?                  @map("origin_run_id") @db.Text
  originTransitionId    String?                  @map("origin_transition_id") @db.Text
  createdBySource       ProductRecordSource      @map("created_by_source")
  lastUpdatedBySource   ProductRecordSource      @map("last_updated_by_source")
  traceId               String?                  @map("trace_id") @db.Text
  sourceObservedAtUtc   DateTime?                @map("source_observed_at_utc") @db.Timestamptz(3)
  metadataNotes         String?                  @map("metadata_notes") @db.Text
  createdAtUtc          DateTime                 @map("created_at_utc") @db.Timestamptz(3)
  updatedAtUtc          DateTime                 @map("updated_at_utc") @db.Timestamptz(3)
  archivedAtUtc         DateTime?                @map("archived_at_utc") @db.Timestamptz(3)
  signalCandidate       SignalCandidateRecord    @relation(fields: [signalCandidateId], references: [signalCandidateId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([signalCandidateId, evaluationWindowId], map: "uq_evaluation_result_candidate_window")
  @@index([signalCandidateId], map: "idx_evaluation_result_signal_candidate_id")
  @@index([evaluationWindowId], map: "idx_evaluation_result_evaluation_window_id")
  @@index([evaluationStatus], map: "idx_evaluation_result_evaluation_status")
  @@map("evaluation_result")
  @@schema("product_domain")
}

model SetupAggregateResultRecord {
  setupAggregateResultId         String                    @id(map: "setup_aggregate_result_pkey") @map("setup_aggregate_result_id") @db.Text
  version                        Int                       @map("version")
  lifecycleStatus                PersistedLifecycleStatus  @map("lifecycle_status")
  aggregateStatus                AggregateComputationStatus @map("aggregate_status")
  setupDefinitionId              String                    @map("setup_definition_id") @db.Text
  researchHypothesisId           String?                   @map("research_hypothesis_id") @db.Text
  scopeKey                       String                    @map("scope_key") @db.Text
  scopeEvaluationWindowId        String?                   @map("scope_evaluation_window_id") @db.Text
  scopeSymbolScopeKind           AggregationSymbolScopeKind @map("scope_symbol_scope_kind")
  scopeSymbolIds                 String[]                  @map("scope_symbol_ids")
  scopeTimeRangeStartAtUtc       DateTime                  @map("scope_time_range_start_at_utc") @db.Timestamptz(3)
  scopeTimeRangeEndAtUtc         DateTime                  @map("scope_time_range_end_at_utc") @db.Timestamptz(3)
  scopeResearchRunId             String?                   @map("scope_research_run_id") @db.Text
  scopeHypothesisId              String?                   @map("scope_hypothesis_id") @db.Text
  totalCandidates                Int                       @map("total_candidates")
  completedEvaluations           Int                       @map("completed_evaluations")
  invalidatedEvaluations         Int                       @map("invalidated_evaluations")
  averagePercentageMove          Float?                    @map("average_percentage_move") @db.DoublePrecision
  averageAbsoluteMove            Float?                    @map("average_absolute_move") @db.DoublePrecision
  averageFinalOutcome            Float?                    @map("average_final_outcome") @db.DoublePrecision
  averageMaxFavorableExcursion   Float?                    @map("average_max_favorable_excursion") @db.DoublePrecision
  averageMaxAdverseExcursion     Float?                    @map("average_max_adverse_excursion") @db.DoublePrecision
  positiveOutcomeCount           Int                       @map("positive_outcome_count")
  computedAtUtc                  DateTime?                 @map("computed_at_utc") @db.Timestamptz(3)
  notes                          String?                   @map("notes") @db.Text
  originRunId                    String?                   @map("origin_run_id") @db.Text
  originTransitionId             String?                   @map("origin_transition_id") @db.Text
  createdBySource                ProductRecordSource       @map("created_by_source")
  lastUpdatedBySource            ProductRecordSource       @map("last_updated_by_source")
  traceId                        String?                   @map("trace_id") @db.Text
  sourceObservedAtUtc            DateTime?                 @map("source_observed_at_utc") @db.Timestamptz(3)
  metadataNotes                  String?                   @map("metadata_notes") @db.Text
  createdAtUtc                   DateTime                  @map("created_at_utc") @db.Timestamptz(3)
  updatedAtUtc                   DateTime                  @map("updated_at_utc") @db.Timestamptz(3)
  archivedAtUtc                  DateTime?                 @map("archived_at_utc") @db.Timestamptz(3)
  setupDefinition                SetupDefinitionRecord     @relation(fields: [setupDefinitionId], references: [setupDefinitionId], onDelete: Restrict, onUpdate: Cascade)
  researchHypothesis             ResearchHypothesisRecord? @relation(fields: [researchHypothesisId], references: [researchHypothesisId], onDelete: Restrict, onUpdate: Cascade)
  feedbackDecisions              ResearchFeedbackDecisionRecord[]

  @@unique([setupDefinitionId, scopeKey], map: "uq_setup_aggregate_result_scope_key")
  @@index([setupDefinitionId], map: "idx_setup_aggregate_result_setup_definition_id")
  @@index([researchHypothesisId], map: "idx_setup_aggregate_result_research_hypothesis_id")
  @@index([aggregateStatus], map: "idx_setup_aggregate_result_aggregate_status")
  @@index([scopeEvaluationWindowId], map: "idx_setup_aggregate_result_scope_evaluation_window_id")
  @@map("setup_aggregate_result")
  @@schema("product_domain")
}

model ResearchFeedbackDecisionRecord {
  researchFeedbackDecisionId String                         @id(map: "research_feedback_decision_pkey") @map("research_feedback_decision_id") @db.Text
  version                    Int                            @map("version")
  lifecycleStatus            PersistedLifecycleStatus       @map("lifecycle_status")
  decisionStatus             ResearchFeedbackDecisionStatus @map("decision_status")
  setupDefinitionId          String                         @map("setup_definition_id") @db.Text
  researchHypothesisId       String                         @map("research_hypothesis_id") @db.Text
  setupAggregateResultId     String?                        @map("setup_aggregate_result_id") @db.Text
  evidenceStatus             HypothesisEvidenceStatus       @map("evidence_status")
  recommendedAction          ResearchFeedbackDecisionAction @map("recommended_action")
  rationaleSummary           String                         @map("rationale_summary") @db.Text
  requiresManualReview       Boolean                        @map("requires_manual_review")
  evidenceSummary            String?                        @map("evidence_summary") @db.Text
  reviewerMetadata           Json?                          @map("reviewer_metadata")
  originRunId                String?                        @map("origin_run_id") @db.Text
  originTransitionId         String?                        @map("origin_transition_id") @db.Text
  createdBySource            ProductRecordSource            @map("created_by_source")
  lastUpdatedBySource        ProductRecordSource            @map("last_updated_by_source")
  traceId                    String?                        @map("trace_id") @db.Text
  sourceObservedAtUtc        DateTime?                      @map("source_observed_at_utc") @db.Timestamptz(3)
  metadataNotes              String?                        @map("metadata_notes") @db.Text
  createdAtUtc               DateTime                       @map("created_at_utc") @db.Timestamptz(3)
  updatedAtUtc               DateTime                       @map("updated_at_utc") @db.Timestamptz(3)
  archivedAtUtc              DateTime?                      @map("archived_at_utc") @db.Timestamptz(3)
  setupDefinition            SetupDefinitionRecord          @relation(fields: [setupDefinitionId], references: [setupDefinitionId], onDelete: Restrict, onUpdate: Cascade)
  researchHypothesis         ResearchHypothesisRecord       @relation(fields: [researchHypothesisId], references: [researchHypothesisId], onDelete: Restrict, onUpdate: Cascade)
  setupAggregateResult       SetupAggregateResultRecord?    @relation(fields: [setupAggregateResultId], references: [setupAggregateResultId], onDelete: Restrict, onUpdate: Cascade)
  approvals                  ResearchDecisionApprovalRecord[]
  setupDefinitionRevisions   SetupDefinitionRevisionRecord[] @relation("SetupDefinitionRevisionFeedback")
  setupLifecycleMutationRecords SetupLifecycleMutationRecordRecord[]
  setupRefinementRequests    SetupRefinementRequestRecord[] @relation("SetupRefinementRequestFeedback")

  @@index([setupDefinitionId], map: "idx_research_feedback_decision_setup_definition_id")
  @@index([researchHypothesisId], map: "idx_research_feedback_decision_research_hypothesis_id")
  @@index([setupAggregateResultId], map: "idx_research_feedback_decision_setup_aggregate_result_id")
  @@index([decisionStatus], map: "idx_research_feedback_decision_decision_status")
  @@index([recommendedAction], map: "idx_research_feedback_decision_recommended_action")
  @@map("research_feedback_decision")
  @@schema("product_domain")
}

model ResearchDecisionApprovalRecord {
  researchDecisionApprovalId String                          @id(map: "research_decision_approval_pkey") @map("research_decision_approval_id") @db.Text
  version                    Int                             @map("version")
  lifecycleStatus            PersistedLifecycleStatus        @map("lifecycle_status")
  approvalStatus             ResearchDecisionApprovalStatus  @map("approval_status")
  researchFeedbackDecisionId String                          @map("research_feedback_decision_id") @db.Text
  setupDefinitionId          String                          @map("setup_definition_id") @db.Text
  reviewedBy                 String                          @map("reviewed_by") @db.Text
  reviewedAtUtc              DateTime                        @map("reviewed_at_utc") @db.Timestamptz(3)
  approvalOutcome            ResearchDecisionApprovalOutcome @map("approval_outcome")
  reviewerNotes              String?                         @map("reviewer_notes") @db.Text
  authorizedNextAction       ResearchFeedbackDecisionAction? @map("authorized_next_action")
  originRunId                String?                         @map("origin_run_id") @db.Text
  originTransitionId         String?                         @map("origin_transition_id") @db.Text
  createdBySource            ProductRecordSource             @map("created_by_source")
  lastUpdatedBySource        ProductRecordSource             @map("last_updated_by_source")
  traceId                    String?                         @map("trace_id") @db.Text
  sourceObservedAtUtc        DateTime?                       @map("source_observed_at_utc") @db.Timestamptz(3)
  metadataNotes              String?                         @map("metadata_notes") @db.Text
  createdAtUtc               DateTime                        @map("created_at_utc") @db.Timestamptz(3)
  updatedAtUtc               DateTime                        @map("updated_at_utc") @db.Timestamptz(3)
  archivedAtUtc              DateTime?                       @map("archived_at_utc") @db.Timestamptz(3)
