{
  "name": "@monitor/domain-model",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "build": "tsc -p tsconfig.json",
    "prebuild": "pnpm run prisma:generate",
    "pretest:integration": "pnpm run prisma:generate",
    "pretypecheck": "pnpm run prisma:generate",
    "pretest": "pnpm run prisma:generate",
    "prelint": "pnpm run prisma:generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 ./test/**/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 ./test/**/*.integration.test.ts",
    "verify:persistence": "pnpm run typecheck && pnpm run test && pnpm run test:integration",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "tsx": "^4.20.6"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.20.0"
  }
}
