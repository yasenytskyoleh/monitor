{
  "$id": "https://monitor/schemas/agents-file.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "https://monitor/schemas/agent-config.schema.json"
      },
      "minItems": 1
    }
  },
  "required": ["version", "schemaVersion", "agents"]
}
