{
  "$id": "https://monitor/schemas/runtime-defaults.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jsonModeRequired": {
          "type": "boolean"
        },
        "defaultProvider": {
          "type": "string",
          "enum": ["openai"]
        },
        "defaultModel": {
          "type": "string",
          "minLength": 1
        },
        "fallbackModel": {
          "type": "string",
          "minLength": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 1
        },
        "maxArtifactsPerOutput": {
          "type": "integer",
          "minimum": 1
        },
        "retryPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxRetries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "backoffMs": {
              "type": "integer",
              "minimum": 0
            },
            "retryOn": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": ["maxRetries"]
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000
        },
        "concurrency": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxParallelTasks": {
              "type": "integer",
              "minimum": 1
            },
            "maxParallelActionsPerTask": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": ["maxParallelTasks", "maxParallelActionsPerTask"]
        }
      },
      "required": ["defaultProvider", "defaultModel", "temperature", "maxTokens", "retryPolicy", "timeoutMs"]
    }
  },
  "required": ["version", "schemaVersion", "runtime"]
}
