{
  "$id": "https://monitor/schemas/rejection-event.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "minLength": 1
    },
    "rejectionCode": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "blockingArtifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "recommendedNextAction": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["taskId", "state", "rejectionCode", "reason", "blockingArtifacts", "recommendedNextAction"]
}
