{
  "$id": "https://monitor/schemas/prompt-reference.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "file": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\.txt$"
    }
  },
  "required": ["version", "file"]
}
