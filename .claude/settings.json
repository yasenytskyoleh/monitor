{
  "permissions": {
    "allow": [
      "Bash(pnpm build)",
      "Bash(pnpm build:*)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm verify:persistence)",
      "Bash(pnpm --filter @monitor/domain-model test:*)",
      "Bash(pnpm --filter @monitor/domain-model typecheck:*)",
      "Bash(pnpm --filter @monitor/domain-model run prisma:generate)",
      "Bash(pnpm --filter @monitor/orchestrator-core test:*)",
      "Bash(pnpm --filter @monitor/agent-config test:*)"
    ],
    "deny": [
      "Read(.env)",
      "Edit(.env)",
      "Write(.env)",
      "Read(.env.local)",
      "Edit(.env.local)",
      "Write(.env.local)",
      "Edit(packages/domain-model/src/generated/**)",
      "Write(packages/domain-model/src/generated/**)"
    ]
  }
}
